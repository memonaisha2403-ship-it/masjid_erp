# Copy to .env and edit. Never commit real secrets.
NODE_ENV=production
PORT=3000
# Public URL of this app (used in receipt links, QR codes and WhatsApp messages)
BASE_URL=https://masjid.example.org
# Supabase: Project settings → Database → Connection string (use the *pooler* URI, session mode, or the direct URI)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# 32+ random chars. Encrypts gateway secrets at rest. Changing it invalidates stored Razorpay secrets.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Set when behind a reverse proxy / PaaS so client IPs and secure cookies work (1 = one proxy hop)
TRUST_PROXY=1
# Allow the single-file HTML (taqvion.html) to be opened from other origins, e.g. file:// or a preview. Comma list or *
CORS_ORIGINS=*
SESSION_DAYS=14
DEFAULT_COUNTRY_CODE=91
